           VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
        ).bind(s.title, s.value || "", s.unit || "", s.description || "", s.icon || "", s.section || "about_stats", s.sort_order || 0, s.is_published ? 1 : 0).run();
      }
    }
    return jsonResponse({ success: true });
  } catch (err) {
